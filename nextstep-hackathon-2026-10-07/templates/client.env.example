# Copy to client/.env.local only if it does not already exist.
# VITE_ variables are public in the browser bundle.
VITE_API_BASE_URL=http://localhost:3001
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Optional, public confirmation return URL. Add this exact URL in Supabase Redirect URLs.
# Defaults: hosted HTTPS origin + /login; local signup returns to the public NextStep site.
# For a separate development project only, explicitly use http://127.0.0.1:5173/login.
VITE_AUTH_REDIRECT_URL=https://next-step-six-theta.vercel.app/login
